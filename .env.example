# API keys of the reading ladder's providers (see DESIGN.md "Reading")
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# Monthly spend cap for model calls (escalation stops when reached)
MONTHLY_CAP_USD=2

# Cards whose last 4 digits are not in their ПлатежноСредство name (card=method, comma-
# separated); other cards match by their digits in the name
CARD_METHODS=

# Google Sheets
GOOGLE_SHEETS_ID=your-spreadsheet-id-here
GOOGLE_SHEETS_WORKSHEET=Sheet1
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# offers (hand-off of ok receipts, DESIGN.md "Hand-off to offers"): unset OFFERS_URL →
# receipts are queued but not sent. OFFERS_TOKEN = offers' OFFERS_RECEIPTS_TOKEN.
OFFERS_URL=
OFFERS_TOKEN=
# Where offers' photo_url points (default https://rec.fireto.net)
# RECEIPTS_PUBLIC_URL=https://rec.fireto.net

# Local development only (never in production):
#   RECEIPTS_READER=0     no reader thread;  =fake  canned readings, no model calls
#   RECEIPTS_SHEET=fake   an in-memory Sheet instead of Google
#   RECEIPTS_DATA=data    the database and photo directory
